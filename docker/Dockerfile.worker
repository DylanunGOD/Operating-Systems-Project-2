# syntax=docker/dockerfile:1
# ============================================================
# Dockerfile.worker — Worker GENÉRICO (todas las libs de ML).
# Útil para correr cualquier tipo vía WORKER_TYPE. Imagen pesada;
# en producción preferir las imágenes específicas (worker-text/image/audio).
# ============================================================
FROM python:3.11-slim AS base
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    WORKER_TYPE=text
WORKDIR /app

FROM base AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
RUN pip install --prefix=/install -r requirements.txt

FROM base AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 ffmpeg \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /install /usr/local
COPY src ./src
RUN useradd --create-home appuser && chown -R appuser /app
USER appuser
EXPOSE 8001
# Toma el tipo de WORKER_TYPE (default text).
CMD ["python", "-m", "src.monitoring.worker_runner"]
