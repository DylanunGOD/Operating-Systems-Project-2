{
  "uid": "database",
  "title": "Base de Datos (PostgreSQL)",
  "tags": ["analysis", "postgres"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "description": "Requiere postgres_exporter (job=postgres) apuntando al Primary y Réplicas.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Nodos PostgreSQL arriba",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(pg_up)", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Conexiones activas",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count) by (instance)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Lag de replicación (bytes)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "pg_replication_lag_bytes",
          "legendFormat": "{{application_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Commits vs Rollbacks (rate)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit[5m]))",
          "legendFormat": "commits",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pg_stat_database_xact_rollback[5m]))",
          "legendFormat": "rollbacks",
          "refId": "B"
        }
      ]
    }
  ]
}
