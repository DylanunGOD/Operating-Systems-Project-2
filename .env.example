# ============================================================
# API
# ============================================================
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
SECRET_KEY=change-me-in-production
# HS256 simetrico para dev; en prod cambiar a RS256 con par de llaves
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=analysis-distributed-api

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=analysis_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

POSTGRES_REPLICA1_HOST=localhost
POSTGRES_REPLICA1_PORT=5433
POSTGRES_REPLICA2_HOST=localhost
POSTGRES_REPLICA2_PORT=5434

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================================
# Redis
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================
# Kafka
# ============================================================
# false = modo dev (Console publisher + InMemory consumer). true = broker real.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TEXT=analysis.text.tasks
KAFKA_TOPIC_IMAGE=analysis.image.tasks
KAFKA_TOPIC_AUDIO=analysis.audio.tasks
KAFKA_TOPIC_RESULTS=analysis.results
KAFKA_GROUP_ID=analysis-workers
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_CLIENT_ID=analysis-platform
# Si el broker no responde en este tiempo, los workers caen al consumer en
# memoria (modo dev). Subir en produccion si la red es lenta.
KAFKA_PROBE_TIMEOUT_SECONDS=5.0

# ============================================================
# Workers
# ============================================================
TEXT_WORKER_REPLICAS=2
IMAGE_WORKER_REPLICAS=2
AUDIO_WORKER_REPLICAS=2
WORKER_TIMEOUT_SECONDS=300

# ============================================================
# Storage (S3/GCS para archivos multimedia)
# ============================================================
STORAGE_BUCKET=analysis-files
STORAGE_PROVIDER=gcs
GCS_PROJECT_ID=your-gcp-project

# ============================================================
# Monitoring
# ============================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
